version: '3.8'

services:
  minio:
    image: minio/minio:latest
    command: >
      server
      http://tasks.minio_stack_minio/mnt/minio/data{1...2}
      --console-address ":9001"
    ports:
      - "9000:9000"
      - "9001:9001"
    networks:
      - ai-net
    secrets:
      - minio_root_user
      - minio_root_password
    environment:
      MINIO_ROOT_USER_FILE: /run/secrets/minio_root_user
      MINIO_ROOT_PASSWORD_FILE: /run/secrets/minio_root_password
    volumes:
      - /mnt/minio/data1:/mnt/minio/data1
      - /mnt/minio/data2:/mnt/minio/data2
    deploy:
      mode: replicated
      replicas: 2
      restart_policy:
        condition: on-failure


networks:
  ai-net:
    external: true

secrets:
  minio_root_user:
    external: true
  minio_root_password:
    external: true