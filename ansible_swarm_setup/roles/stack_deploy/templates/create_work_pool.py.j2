import asyncio
from prefect.client.orchestration import get_client
from prefect.client.schemas.actions import WorkPoolCreate

async def create_work_pool():
    async with get_client() as client:
        pool_name = "my-docker-pool"

        base_job_template = {
            "job_configuration": {
                "image": "algofusion/datafusion_api_server",
                "command": ["prefect", "flow-run", "execute"],
                "env": {
                    "PREFECT_API_URL": "http://18.61.15.199:4200/api",
                    "PREFECT_LOGGING_LEVEL": "INFO"
                },
                "network_mode": "ai-net",
                "auto_remove": True
            },
            "variables": {
                "type": "object",
                "properties": {
                    "image": {"type": "string", "default": "algofusion/datafusion_api_server"},
                    "command": {"type": "array", "items": {"type": "string"}},
                    "env": {"type": "object"},
                    "network_mode": {"type": "string", "default": "ai-net"}
                }
            }
        }

        try:
            print(f"Creating work pool '{pool_name}'...")
            await client.create_work_pool(
                WorkPoolCreate(
                    name=pool_name,
                    type="docker",
                    base_job_template=base_job_template
                )
            )
            print(f"✅ Successfully created work pool '{pool_name}'")
        except Exception as e:
            print(f"⚠️ Work pool '{pool_name}' may already exist or failed: {e}")

if __name__ == "__main__":
    asyncio.run(create_work_pool())
